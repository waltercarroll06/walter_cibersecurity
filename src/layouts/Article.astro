---
import Layout from './Layout.astro';
import { formatDate, readTime, withBase, type Entry } from '../lib/content';
interface Props { entry: Entry }
const { entry } = Astro.props;
const isLab = entry.collection === 'labs';
---
<Layout title={isLab ? 'Laboratorio' : 'Apunte'} pageTitle={entry.data.title} description={entry.data.description} active={isLab ? 'laboratorios' : 'diario'}>
  <article class="article"><a class="text-link" href={withBase(isLab ? 'laboratorios/' : 'diario/')}>{isLab ? 'Todos los laboratorios' : 'Todos los apuntes'}</a><header class="article-header"><div class="entry-top"><span class="tag">{entry.data.category}</span><span class="muted">{formatDate(entry.data.date)} · {readTime(entry.body)} min</span></div><h1>{entry.data.title}</h1><p class="lead">{entry.data.description}</p><div class="tags">{entry.data.tags.map(tag => <a href={`${withBase('buscar/')}?q=${encodeURIComponent(tag)}`}>#{tag}</a>)}</div></header>
  {entry.data.example && <div class="callout">Ejemplo editable: úsalo como referencia para escribir tu propia experiencia.</div>}
  {entry.data.source && <p class="muted small">Referencia de estudio: {entry.data.source}</p>}
  <div class="prose"><slot /></div><div class="article-end"><h2>Una idea para la próxima sesión</h2><p>Explica este tema con tus propias palabras, pruébalo y anota lo que todavía no está claro.</p><a class="button secondary" href={withBase('nuevo/')}>Documentar lo aprendido</a></div></article>
</Layout>
