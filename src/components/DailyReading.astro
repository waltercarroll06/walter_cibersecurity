---
import { withBase } from '../lib/content';
---
<section class="entry-card reading-panel" id="daily" data-feed={withBase('lectura-del-dia.json')} data-dev={String(import.meta.env.DEV)}>
  <div class="section-heading"><h2>Lectura del día</h2><small id="daily-date"></small></div>
  <article id="daily-article" hidden></article>
  <div class="button-row"><button id="daily-save" class="button primary" type="button" disabled>Guardar lectura</button><button id="daily-refresh" class="button secondary" type="button">Actualizar</button></div>
  <p id="daily-state" role="status"></p>
  <details><summary>Lecturas guardadas (<span id="saved-count">0</span>)</summary><div id="daily-archive"></div></details>
</section>
<style>.reading-panel{margin-bottom:2rem}.reading-panel .section-heading{margin:0}.reading-panel :global(article p),.reading-panel :global(article h3){margin:.6rem 0}.reading-panel details{border-top:1px solid var(--line);padding-top:1rem}.reading-panel summary{cursor:pointer}.reading-panel :global(#daily-archive article){border-top:1px solid var(--line);padding:.9rem 0;margin-top:.75rem}</style>
<script src="../scripts/daily-reading.ts"></script>
