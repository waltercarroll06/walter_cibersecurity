---
interface Props { items: {name:string; use:string; title:string; example:string; url:string}[] }
const { items } = Astro.props;
---
<div class="cards-grid">{items.map(item =>
  <details class="tool-card">
    <summary><span class="name">{item.name}</span><span class="use">{item.use}</span><span class="action"><span class="closed">Ver ejemplo</span><span class="opened">Cerrar ejemplo</span></span></summary>
    <div class="inside"><h3>{item.title}</h3><p>{item.example}</p><a class="text-link" href={item.url}>Más sobre {item.name}</a></div>
  </details>
)}</div>
<style>
.cards-grid{align-items:start}.tool-card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius)}summary,.inside{padding:1.2rem}summary{cursor:pointer;display:grid;gap:.5rem}summary::-webkit-details-marker{display:none}.name{font-weight:650;font-size:1.15rem}.use{color:var(--muted)}.action{color:var(--accent);font-size:.875rem}.opened,details[open] .closed{display:none}details[open] .opened{display:inline}.inside{border-top:1px solid var(--line)}.inside p{margin:.65rem 0}
</style>
