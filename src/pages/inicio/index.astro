---
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../lib/content';
---
<Layout title="Inicio">
  <script is:inline>
    try {
      const entered=Number(sessionStorage.getItem('wdl:portal-entry'));
      sessionStorage.removeItem('wdl:portal-entry');
      if(Date.now()-entered<10000) document.documentElement.classList.add('from-portal');
    } catch {}
  </script>
  <section class="hero-copy"><p class="eyebrow">MI LEARNING JOURNEY · REDES</p><h1>Un módulo al día.<br /><span>Aprender y tomar apuntes.</span></h1><p class="hero-description">Mis apuntes de Cisco por módulo y mis prácticas de Linux por día de estudio.</p><div class="button-row"><a class="button primary" href={withBase('nuevo/')}>Escribir mis apuntes</a><a class="button secondary" href={withBase('roadmap/')}>Mi plan de estudio</a><a class="button secondary" href={withBase('linux/')}>Abrir bitácora de Linux</a></div></section></Layout>

<style is:global>
  @media(prefers-reduced-motion:no-preference){
    html.from-portal::after{content:'';position:fixed;inset:0;z-index:100;pointer-events:none;background:#111617;animation:portal-arrival .45s ease-out forwards}
    @keyframes portal-arrival{to{opacity:0;visibility:hidden}}
  }
</style>
