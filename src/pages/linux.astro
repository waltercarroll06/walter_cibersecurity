---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Linux" active="linux" description="Mis apuntes de Linux organizados por día de estudio.">
  <div class="page-heading">
    <div>
      <h1>Linux</h1>
      <p>Guarda tus apuntes y prácticas de Linux por día de estudio.</p>
    </div>
  </div>

  <div class="journal">
    <section class="entry-card" aria-labelledby="linux-days-heading">
      <h2 id="linux-days-heading">Días de estudio</h2>
      <form id="linux-day-form">
        <div>
          <label for="linux-day">Número de día</label>
          <input id="linux-day" type="number" min="1" max="9007199254740991" step="1" placeholder="Ej. 1" required />
        </div>
        <button class="button primary" type="submit">Abrir día</button>
      </form>
      <p id="linux-empty" class="small">Aún no tienes apuntes de Linux.</p>
      <ul id="linux-days" class="day-list" hidden></ul>
    </section>

    <section id="linux-entry" class="entry-card" aria-labelledby="linux-entry-heading" hidden>
      <h2 id="linux-entry-heading"></h2>
      <div>
        <label for="linux-title">Título (opcional)</label>
        <input id="linux-title" type="text" maxlength="160" placeholder="Tema que estudiaste" />
      </div>
      <div>
        <label for="linux-notes">Apuntes</label>
        <textarea id="linux-notes" rows="14" placeholder="Escribe tus apuntes, comandos o dudas."></textarea>
      </div>
      <div class="button-row">
        <button id="linux-download" class="button secondary" type="button">Descargar Markdown</button>
      </div>
    </section>
  </div>

  <p id="linux-status" class="status-message" role="status">Los apuntes se guardan al escribir en este navegador.</p>
  <script src="../scripts/linux-journal.ts"></script>
</Layout>

<style>
  .journal { display: grid; grid-template-columns: minmax(0, 19rem) minmax(0, 1fr); align-items: start; gap: 24px; }
  #linux-day-form { display: flex; align-items: end; gap: 10px; }
  #linux-day-form > div { flex: 1; min-width: 0; }
  #linux-day-form .button { min-height: 47px; white-space: nowrap; }
  .day-list { display: grid; gap: 8px; list-style: none; margin: 0; padding: 0; }
  .day-list :global(button) { justify-content: flex-start; width: 100%; text-align: left; overflow-wrap: anywhere; }
  .day-list :global([aria-current='true']) { border-color: var(--accent); color: var(--accent); }

  @media (max-width: 800px) {
    .journal { grid-template-columns: 1fr; }
  }
</style>
