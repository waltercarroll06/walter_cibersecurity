---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/content';
import { networkTools, forensicTools } from '../data/security-tools';
const groups = [
  { id: 'defensa', title: 'Redes y defensa', tools: networkTools,
    question: '¿Qué hizo que el servicio dejara de responder?', caseName: 'Cloudflare · 2 de julio de 2019',
    image: 'caso-cloudflare.png', alt: 'Secuencia del incidente: a las 14:07 UTC se desactivó el cortafuegos web, a las 14:09 se normalizaron el tráfico y la CPU y a las 14:52 se reactivó la protección.',
    text: 'Una nueva regla del cortafuegos web agotó la CPU. Los ingenieros miraron los datos de rendimiento y los registros de errores. Otro integrante utilizó strace para confirmar el diagnóstico. Al desactivar el componente, comprobaron si la CPU y el tráfico volvían a su nivel habitual.',
    source: 'Informe técnico de Cloudflare', url: 'https://blog.cloudflare.com/details-of-the-cloudflare-outage-on-july-2-2019/' },
  { id: 'forense', title: 'Análisis forense digital', tools: forensicTools,
    question: '¿Cómo se convierte un metadato en una pista?', caseName: 'Investigación BTK · Wichita, 2005',
    image: 'caso-disquete.png', alt: 'Esquema del disquete y de dos datos hallados: Dennis y Christ Lutheran Church.',
    text: 'Los investigadores examinaron un disquete enviado a una emisora. Encontraron un nombre y el de una iglesia. Al contrastarlos con información pública, identificaron una persona de interés. La investigación incorporó otras evidencias, incluido ADN. El nombre del archivo o de su autor, por sí solo, habría sido insuficiente.',
    source: 'Informe del programa RCFL, pág. 11', url: 'https://www.rcfl.gov/file-repository/rcfl_nat_annual05.pdf#page=13' },
];
---
<Layout title="Herramientas" active="herramientas">
  <header class="page-heading"><div><h1>Herramientas de ciberseguridad</h1><p>Elige según la pregunta que intentas responder y el tipo de evidencia que tienes delante.</p></div></header>
  <nav class="filter-links" aria-label="Secciones de herramientas">{groups.map(g => <a class="tag" href={'#'+g.id}>{g.title}</a>)}<a class="tag" href="#tutor">IA para mis apuntes</a></nav>
  {groups.map(group => <section id={group.id} class="tool-group">
    <h2>{group.title}</h2>
    <div class="cards-grid">{group.tools.map(tool => <article class="entry-card"><h3>{tool.name}</h3><p>{tool.use}</p><p><strong>Ejemplo.</strong> {tool.example}</p><a class="text-link" href={tool.url}>Documentación de {tool.name}</a></article>)}</div>
    <article class="entry-card case"><div><p class="eyebrow">{group.caseName}</p><h3>{group.question}</h3><p>{group.text}</p><a class="text-link" href={group.url}>{group.source}</a></div><figure><img src={withBase(group.image)} alt={group.alt} loading="lazy" width="760" height="360"/><figcaption>Esquema basado en el informe del caso.</figcaption></figure></article>
  </section>)}
  <section id="tutor" class="entry-card"><h2>IA para mis apuntes</h2><p>En Cisco puedes leer objetivos de una captura y resumir un módulo. En Linux puedes resumir el día y consultar cada parte de un comando.</p><div class="button-row"><a class="button secondary" href={withBase('nuevo/')}>Tutor de Cisco</a><a class="button secondary" href={withBase('linux/')}>Tutor de Linux</a></div></section>
</Layout>
<style>
.tool-group{margin:2rem 0 3rem;scroll-margin-top:1rem}.tool-group>h2{margin-bottom:1rem}.case{margin-top:1.25rem;display:grid;grid-template-columns:1fr 1fr;align-items:center}.case p,.case h3{margin-bottom:.8rem}figure{margin:0}figure img{width:100%;height:auto;border-radius:8px}figcaption{font-size:.8rem;color:var(--muted)}@media(max-width:820px){.case{grid-template-columns:1fr}}
</style>
