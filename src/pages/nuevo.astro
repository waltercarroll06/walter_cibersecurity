---
import { courseModules } from '../data/course';
import LocalTutor from '../components/LocalTutor.astro';
import { withBase } from '../lib/content';
import Layout from '../layouts/Layout.astro';
---
<Layout title="Nuevo apunte" active="apuntes"><div class="page-heading"><div><p class="eyebrow">DALE FORMA A LO APRENDIDO</p><h1 id="editor-heading">Mi sesión de redes</h1><p>Escribe en Markdown, revisa la vista previa y descarga el archivo para añadirlo al blog.</p></div></div><a id="all-notes" class="button secondary" href={withBase('apuntes/')}>Volver a Mis apuntes</a>
<div id="network-picker"><label for="module-selector">Módulo del curso</label><select id="module-selector"><option value="">Apunte libre de redes</option>{courseModules.map(module => <option value={module.id}>Módulo {module.number}: {module.title}</option>)}</select></div>
<form id="editor-form"><div class="editor-meta"><div><label for="entry-title">Título</label><input id="entry-title" required maxlength="160" placeholder="¿Qué aprendiste hoy?" /></div><div><label for="entry-category">Tema</label><input id="entry-category" readonly value="Redes" /></div><div><label for="entry-type">Tipo</label><input id="entry-type" maxlength="120" value="Apunte" placeholder="Por ejemplo, reflexión o resumen" /></div><div><label for="entry-date">Fecha</label><input id="entry-date" required type="date" /></div></div><label for="entry-description">Resumen breve</label><input id="entry-description" required maxlength="240" placeholder="La idea principal de esta sesión." /><div class="editor-panels"><div><label for="entry-body">Contenido · Markdown</label><textarea id="entry-body" spellcheck="true" rows="22" aria-describedby="image-help"></textarea><p id="image-help" class="muted small">Imagen: ![Descripción](../../assets/mi-captura.png). Copia la imagen a src/assets; se mostrará al añadir el archivo al proyecto. La vista previa del editor solo muestra imágenes HTTPS.</p></div><div><h2 class="preview-label">Vista previa</h2><div id="editor-preview" class="prose editor-preview"></div></div></div><div class="button-row"><button type="button" class="button primary" id="complete-module" hidden>Completar módulo</button><button type="submit" class="button secondary">Descargar Markdown</button><button type="button" id="delete-note" class="button secondary">Borrar apunte</button><button type="button" id="copy-markdown" class="button secondary">Copiar Markdown</button></div><p id="editor-status" class="status-message" role="status" aria-live="polite"></p></form><LocalTutor /><script src="../scripts/editor.ts"></script></Layout>
