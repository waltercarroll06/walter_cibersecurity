---
import { withBase } from '../lib/content';
const workstation = withBase('portada-computador.webp');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#a9ddbd" />
    <meta name="description" content="Entrada al laboratorio de ciberseguridad de Walter." />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <title>Walter’s Digital Lab</title>
  </head>
  <body>
    <main class="cover" id="cover">
      <header class="masthead">
        <span class="monogram" aria-hidden="true">w<span>.</span></span>
        <h1>Walter’s Digital Lab</h1>
      </header>
      <a class="portal" href={withBase('inicio/')} aria-label="Entrar al laboratorio de ciberseguridad">
        <div class="camera">
          <div class="object" style={{'--photo': `url("${workstation}")`}}>
            <img src={workstation} alt="Computador de escritorio con un escudo en la pantalla" fetchpriority="high" draggable="false" />
            <span class="glass" aria-hidden="true">
              <svg class="lock" viewBox="0 0 96 110" fill="none">
                <path d="M48 6C37 14 24 18 8 21v29c0 24 13 40 40 54 27-14 40-30 40-54V21C72 18 59 14 48 6Z" stroke="currentColor" stroke-width="3.5"/>
                <path d="M39 48v-7a9 9 0 0 1 18 0v7" stroke="currentColor" stroke-width="3.5"/>
                <rect x="33" y="47" width="30" height="26" rx="4" stroke="currentColor" stroke-width="3.5"/>
                <circle cx="48" cy="58" r="2.5" fill="currentColor"/><path d="M48 59v5" stroke="currentColor" stroke-width="2.5"/>
              </svg>
            </span>
          </div>
        </div>
      </a>
    </main>
    <script>
      const cover = document.querySelector<HTMLElement>('#cover')!;
      const link = cover.querySelector<HTMLAnchorElement>('.portal')!;
      const camera = cover.querySelector<HTMLElement>('.camera')!;
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      let journey: Animation | undefined;

      link.addEventListener('pointermove', event => {
        if (event.pointerType !== 'mouse' || reduced.matches || journey) return;
        const box = camera.getBoundingClientRect();
        const x = Math.max(-1, Math.min(1, (event.clientX-box.left)/box.width*2-1));
        const y = Math.max(-1, Math.min(1, (event.clientY-box.top)/box.height*2-1));
        camera.style.setProperty('--yaw', x*3.6+'deg');
        camera.style.setProperty('--pitch', -y*2.4+'deg');
      });
      function center() {
        camera.style.removeProperty('--yaw');
        camera.style.removeProperty('--pitch');
      }
      link.addEventListener('pointerleave', center);
      link.addEventListener('click', event => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        if (reduced.matches || typeof camera.animate !== 'function') return;
        event.preventDefault();
        if (journey) return;
        center();
        const box = camera.getBoundingClientRect();
        const screenX = 0.45, screenY = 0.34;
        const dx = innerWidth/2 - (box.left + box.width*screenX);
        const dy = innerHeight/2 - (box.top + box.height*screenY);
        const zoom = Math.min(2.8, Math.max(1.9, innerWidth / (box.width * .58)));
        camera.style.transformOrigin = (100*screenX)+'% '+(100*screenY)+'%';
        cover.classList.add('entering');
        journey = camera.animate([
          { transform:'translate(0,0) scale(1)', offset:0 },
          { transform:'translate('+dx*.035+'px,'+dy*.035+'px) scale(1.075)', offset:.23 },
          { transform:'translate('+dx+'px,'+dy+'px) scale('+zoom+')' }
        ], { duration:1050, easing:'cubic-bezier(.42,0,.25,1)', fill:'forwards' });
        journey.onfinish = () => {
          try { sessionStorage.setItem('wdl:portal-entry',String(Date.now())); } catch { /* Navigation still works. */ }
          location.assign(link.href);
        };
      });
      window.addEventListener('pageshow', () => {
        journey?.cancel(); journey = undefined;
        camera.style.removeProperty('transform-origin');
        cover.classList.remove('entering'); center();
      });
    </script>
  </body>
</html>
<style>
  :global(*){box-sizing:border-box}
  :global(html),:global(body){margin:0;min-height:100%;background:#a9ddbd;color:#163b30;font-family:'Segoe UI',system-ui,sans-serif}
  .cover{position:relative;min-height:100svh;overflow:clip;display:grid;grid-template-rows:auto 1fr;background:radial-gradient(ellipse at 49% 43%,#c2eed1,#a9ddbd 60%,#88c7a5)}
  .masthead{z-index:2;display:flex;align-items:center;gap:.9rem;padding:clamp(1.4rem,3vw,3rem) clamp(1.4rem,4vw,4.5rem);pointer-events:none;transition:opacity .24s}
  .masthead h1{font-size:clamp(1rem,1.8vw,1.3rem);font-weight:600;letter-spacing:-.045em;margin:0}
  .monogram{background:#183d30;color:#f2f8ee;width:2.2rem;height:2.2rem;display:grid;place-content:center;grid-auto-flow:column;border-radius:8px;font-size:1.6rem;font-weight:700;letter-spacing:-.1em;padding-right:.12em}
  .monogram span{color:#9fe9ae}
  .portal{color:inherit;align-self:center;justify-self:center;display:block;margin:0 0 clamp(1rem,6vh,5rem);outline-offset:5px;border-radius:1rem;-webkit-tap-highlight-color:transparent}
  .portal:focus-visible{outline:3px solid #285742}
  .camera{width:min(94vw,112svh,1050px);aspect-ratio:3/2;perspective:1000px;position:relative}
  .object{position:relative;width:100%;height:100%;transform:rotateY(var(--yaw,0deg)) rotateX(var(--pitch,0deg));transition:transform .25s ease-out}
  .object::before,.object img{display:block;width:100%;height:100%;user-select:none}
  .object::before{content:'';position:absolute;inset:0;background:var(--photo) center/contain no-repeat;filter:hue-rotate(-70deg);mask-image:linear-gradient(to right,transparent,#000 14%,#000 84%,transparent),linear-gradient(to bottom,transparent,#000 15%,#000 84%,transparent);mask-composite:intersect}
  .object img{clip-path:polygon(11% 90%,14.8% 76.5%,19.3% 76%,19.3% 63%,21% 62.5%,19.2% 59%,19.6% 52%,21.8% 10.5%,22.6% 7%,26% 4%,69.8% 3.6%,73% 5.6%,78.5% 16.5%,79.3% 56.5%,77.2% 59.3%,79.1% 60.6%,79.2% 74.4%,77.2% 76.7%,79.4% 78%,82.6% 91.5%,82.1% 94.2%,12% 94.2%,11% 93%)}
  .glass{position:absolute;left:26.7%;top:12.6%;width:35.8%;height:41.5%;border-radius:23% 21% 15% 15% / 18% 20% 12% 12%;overflow:hidden;display:grid;place-items:center;background:radial-gradient(ellipse at 20% 12%,#365d59 0%,transparent 25%),radial-gradient(ellipse at 50% 52%,#17443c,#102e2b 64%,#0a1c1b);box-shadow:inset 0 0 .6vw #061b18}
  .lock{display:block;width:48%;height:78%;color:#b1ffdc}
  .portal:is(:hover,:focus-visible) .lock{color:#e1ffec}
  .cover::after{content:'';position:absolute;inset:0;pointer-events:none;background:#111617;opacity:0;z-index:4}
  .cover.entering::after{opacity:1;transition:opacity .67s ease-in-out .34s}
  .entering .masthead{opacity:0}
  @media(prefers-reduced-motion:no-preference){
    .camera{animation:approach 1s ease-out backwards}
    .glass::after{content:'';position:absolute;inset:-60%;background:linear-gradient(110deg,transparent 44%,#dbffe817 50%,transparent 56%);animation:reflection 8s ease-in-out infinite}
    @keyframes approach{from{opacity:0;translate:0 1.4vh}to{opacity:1;translate:0 0}}
    @keyframes reflection{0%,30%{transform:translateX(-55%)}70%,100%{transform:translateX(55%)}}
  }
  @media(max-height:560px) and (orientation:landscape){.masthead{padding:.65rem 1.25rem}.camera{width:min(74vw,86svh)}.portal{margin:0 0 .75rem}}
  @media(prefers-reduced-motion:reduce){.object{transform:none;transition:none}}
</style>
