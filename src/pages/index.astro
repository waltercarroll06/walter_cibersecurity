---
import { withBase } from '../lib/content';
const rows=['1 2 3 4 5 6 7 8 9 0 − + ←','Q W E R T Y U I O P [ ]','A S D F G H J K L ; ↵','⇧ Z X C V B N M , . ⇧','⌘ Alt Space Alt ◀ ▶'].map(row=>row.split(' '));
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#a9ddbd" />
    <meta name="description" content="Entrada al laboratorio de ciberseguridad de Walter." />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <title>Walter’s Digital Lab</title>
  </head>
  <body>
    <main class="cover" id="cover">
      <header class="masthead">
        <span class="monogram" aria-hidden="true">w<span>.</span></span>
        <h1>Walter’s Digital Lab</h1>
      </header>
      <div class="room" aria-hidden="true"><div class="light"></div><div class="floor"></div></div>
      <a class="portal" href={withBase('inicio/')} aria-label="Entrar al laboratorio de ciberseguridad">
        <div class="camera">
          <div class="shadow" aria-hidden="true"></div>
          <div class="object" aria-hidden="true">
            <div class="monitor box">
              <i class="side"></i><i class="top"></i>
              <div class="face"><div class="bezel"><div class="glass">
              <svg class="lock" viewBox="0 0 96 110" fill="none">
                <path d="M48 6C37 14 24 18 8 21v29c0 24 13 40 40 54 27-14 40-30 40-54V21C72 18 59 14 48 6Z" stroke="currentColor" stroke-width="3.5"/>
                <path d="M39 48v-7a9 9 0 0 1 18 0v7" stroke="currentColor" stroke-width="3.5"/>
                <rect x="33" y="47" width="30" height="26" rx="4" stroke="currentColor" stroke-width="3.5"/>
                <circle cx="48" cy="58" r="2.5" fill="currentColor"/><path d="M48 59v5" stroke="currentColor" stroke-width="2.5"/>
              </svg>
              </div></div><span class="speaker"></span><i class="led"></i></div>
            </div>
            <div class="base box"><i class="side"></i><i class="top"></i><div class="face"><div class="floppy"></div><div class="vents"></div></div></div>
            <div class="keyboard">{rows.map(row=><div class="row">{row.map(key=><span class:list={['key', {space:key==='Space'}]}>{key==='Space'?'':key}</span>)}</div>)}</div>
          </div>
        </div>
      </a>
    </main>
    <script>
      const cover = document.querySelector<HTMLElement>('#cover')!;
      const link = cover.querySelector<HTMLAnchorElement>('.portal')!;
      const camera = cover.querySelector<HTMLElement>('.camera')!;
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      let journey: Animation | undefined;

      link.addEventListener('pointermove', event => {
        if (event.pointerType !== 'mouse' || reduced.matches || journey) return;
        const box = camera.getBoundingClientRect();
        const x = Math.max(-1, Math.min(1, (event.clientX-box.left)/box.width*2-1));
        const y = Math.max(-1, Math.min(1, (event.clientY-box.top)/box.height*2-1));
        camera.style.setProperty('--yaw', x*8+'deg');
        camera.style.setProperty('--pitch', -y*4+'deg');
      });
      function center() {
        camera.style.removeProperty('--yaw');
        camera.style.removeProperty('--pitch');
      }
      link.addEventListener('pointerleave', center);
      link.addEventListener('click', event => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        if (reduced.matches || typeof camera.animate !== 'function') return;
        event.preventDefault();
        if (journey) return;
        center();
        const box = camera.getBoundingClientRect();
        const screenX = 0.49, screenY = 0.36;
        const dx = innerWidth/2 - (box.left + box.width*screenX);
        const dy = innerHeight/2 - (box.top + box.height*screenY);
        const zoom = Math.min(2.8, Math.max(1.9, innerWidth / (box.width * .58)));
        camera.style.transformOrigin = (100*screenX)+'% '+(100*screenY)+'%';
        cover.classList.add('entering');
        journey = camera.animate([
          { transform:'translate(0,0) scale(1)', offset:0 },
          { transform:'translate('+dx*.035+'px,'+dy*.035+'px) scale(1.075)', offset:.23 },
          { transform:'translate('+dx+'px,'+dy+'px) scale('+zoom+')' }
        ], { duration:1050, easing:'cubic-bezier(.42,0,.25,1)', fill:'forwards' });
        journey.onfinish = () => {
          try { sessionStorage.setItem('wdl:portal-entry',String(Date.now())); } catch { /* Navigation still works. */ }
          location.assign(link.href);
        };
      });
      window.addEventListener('pageshow', () => {
        journey?.cancel(); journey = undefined;
        camera.style.removeProperty('transform-origin');
        cover.classList.remove('entering'); center();
      });
    </script>
  </body>
</html>
<style>
  :global(*){box-sizing:border-box}
  :global(html),:global(body){margin:0;min-height:100%;background:#a9ddbd;color:#163b30;font-family:'Segoe UI',system-ui,sans-serif}
  .cover{position:relative;min-height:100svh;overflow:clip;display:grid;grid-template-rows:auto 1fr;background:radial-gradient(ellipse at 49% 43%,#c2eed1,#a9ddbd 60%,#88c7a5)}
  .masthead{z-index:2;display:flex;align-items:center;gap:.9rem;padding:clamp(1.4rem,3vw,3rem) clamp(1.4rem,4vw,4.5rem);pointer-events:none;transition:opacity .24s}
  .masthead h1{font-size:clamp(1rem,1.8vw,1.3rem);font-weight:600;letter-spacing:-.045em;margin:0}
  .monogram{background:#183d30;color:#f2f8ee;width:2.2rem;height:2.2rem;display:grid;place-content:center;grid-auto-flow:column;border-radius:8px;font-size:1.6rem;font-weight:700;letter-spacing:-.1em;padding-right:.12em}
  .monogram span{color:#9fe9ae}
  .portal{color:inherit;align-self:center;justify-self:center;display:block;margin:0 0 clamp(1rem,6vh,5rem);outline-offset:5px;border-radius:1rem;-webkit-tap-highlight-color:transparent}
  .portal:focus-visible{outline:3px solid #285742}
  .room{position:absolute;inset:0;overflow:hidden;pointer-events:none;background:radial-gradient(ellipse at 38% 25%,#d6edcb 0%,transparent 48%),linear-gradient(112deg,#97c9a9,#a4d0ab 49%,#6da08a)}
  .light{position:absolute;inset:-10% -5% 26%;background:linear-gradient(115deg,transparent 23%,#efffd626 23.5%,#efffd635 31%,transparent 31.7%,transparent 33%,#efffd629 33.7%,#efffd61a 45%,transparent 46%);filter:blur(7px)}
  .floor{position:absolute;inset:64% 0 0;background:linear-gradient(180deg,#7eac91,#a2c4a8 14%,#bad2b7);box-shadow:0 -2px 9px #41695324}
  .floor::after{content:'';position:absolute;inset:-1px -40% -90%;background-image:linear-gradient(90deg,#30544412 1px,transparent 1px),linear-gradient(#30544412 1px,transparent 1px);background-size:9rem 4rem;transform:perspective(340px) rotateX(57deg);transform-origin:50% 0;mask-image:linear-gradient(transparent,#000 50%)}
  .portal{position:relative;z-index:1}
  .camera{width:min(96vw,108svh,850px);aspect-ratio:3/2;perspective:1100px;position:relative;container-type:inline-size}
  .object{position:relative;width:100%;height:100%;transform-style:preserve-3d;transform:rotateX(calc(-7deg + var(--pitch,0deg))) rotateY(calc(-21deg + var(--yaw,0deg)));transition:transform .24s ease-out}
  .shadow{position:absolute;left:15%;top:83%;width:72%;height:13%;border-radius:50%;background:radial-gradient(ellipse,#33513eaa,transparent 70%);filter:blur(1.2cqw)}
  .box{position:absolute;transform-style:preserve-3d;--depth:13cqw}
  .box .face,.box .side,.box .top{position:absolute;border-radius:1.1cqw}
  .box .face{inset:0;background:linear-gradient(120deg,#f5ebcd,#d9cba9 70%,#c1b494);box-shadow:inset .32cqw .35cqw .22cqw #fff7dd,inset -.45cqw -.45cqw .35cqw #988d72}
  .box .side{left:98%;width:var(--depth);height:100%;transform-origin:left center;transform:rotateY(88deg);background:linear-gradient(to right,#b5a689,#8c836b);border-radius:.6cqw}
  .box .top{left:0;top:1%;height:var(--depth);width:100%;transform-origin:top;transform:rotateX(-89deg);background:linear-gradient(#eaddbd,#c5bea6)}
  .monitor{left:24%;top:14%;width:48%;height:48%;--depth:17cqw}
  .monitor .side::before{content:'';position:absolute;inset:11% 10% 17% 27%;background:repeating-linear-gradient(to bottom,#5f5e4f 0 .32cqw,transparent .32cqw 1.2cqw);border-radius:1cqw}
  .bezel{position:absolute;inset:7% 10% 12%;padding:1.6cqw;border-radius:2.1cqw;background:linear-gradient(137deg,#766f59,#b5aa8f 38%,#f0e7ca 80%);box-shadow:0 .16cqw .15cqw #fff8de}
  .glass{position:relative;display:grid;place-items:center;height:100%;overflow:hidden;border-radius:11% / 13%;background:radial-gradient(ellipse at 23% 7%,#52746b70,transparent 45%),radial-gradient(ellipse,#205443,#102c25 75%);box-shadow:inset 0 0 1.3cqw #09221a}
  .speaker{position:absolute;left:12%;bottom:5.2%;width:12%;height:2.2%;background:repeating-linear-gradient(90deg,#847b64 0 .28cqw,transparent .28cqw .68cqw)}
  .led{position:absolute;right:13%;bottom:5%;width:.7cqw;height:.7cqw;border-radius:50%;background:#a9ffbc;box-shadow:0 0 .7cqw #55bc76}
  .base{left:22%;top:63%;width:53%;height:11%;--depth:15cqw}
  .floppy{position:absolute;right:9%;top:29%;width:37%;height:42%;border:solid .22cqw #a69c80;border-radius:.3cqw;background:linear-gradient(#b6ac8d 40%,#423f34 42% 64%,#b7ae93 68%)}
  .vents{position:absolute;left:8%;top:36%;width:21%;height:29%;background:repeating-linear-gradient(90deg,#817b64 0 .35cqw,transparent .35cqw .95cqw)}
  .keyboard{position:absolute;left:16%;bottom:5%;width:66%;height:24%;padding:1.3cqw 1.8cqw;display:grid;gap:.3cqw;transform:translateZ(3cqw) rotateX(44deg);transform-origin:center bottom;border-radius:1.1cqw;background:linear-gradient(#e1d6b8,#c6bba1);box-shadow:0 .7cqw #968e77,0 1.35cqw 1.15cqw #39523b55}
  .row{display:flex;gap:.31cqw;justify-content:center}.key{display:grid;place-items:center;flex:1;max-width:10%;font:600 .88cqw monospace;color:#5a5546;border-radius:.22cqw;background:linear-gradient(135deg,#faf1d8,#d7caae);box-shadow:inset -.18cqw -.25cqw #afa58b,0 .12cqw .15cqw #968b73}.space{flex:6;max-width:50%}
  .row:first-child .key:first-child{background:#df9c65}
  .lock{display:block;width:48%;height:78%;color:#b1ffdc}
  .portal:is(:hover,:focus-visible) .lock{color:#e1ffec}
  .cover::after{content:'';position:absolute;inset:0;pointer-events:none;background:#111617;opacity:0;z-index:4}
  .cover.entering::after{opacity:1;transition:opacity .67s ease-in-out .34s}
  .entering .masthead{opacity:0}
  @media(prefers-reduced-motion:no-preference){
    .camera{animation:approach 1s ease-out backwards}
    .glass::after{content:'';position:absolute;inset:-60%;background:linear-gradient(110deg,transparent 44%,#dbffe817 50%,transparent 56%);animation:reflection 8s ease-in-out infinite}
    @keyframes approach{from{opacity:0;translate:0 1.4vh}to{opacity:1;translate:0 0}}
    @keyframes reflection{0%,30%{transform:translateX(-55%)}70%,100%{transform:translateX(55%)}}
  }
  @media(max-height:560px) and (orientation:landscape){.masthead{padding:.65rem 1.25rem}.camera{width:min(74vw,86svh)}.portal{margin:0 0 .75rem}}
  @media(prefers-reduced-motion:reduce){.object{transition:none}}
</style>
