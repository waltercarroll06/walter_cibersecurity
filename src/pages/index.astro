---
import { withBase } from '../lib/content';
const workstation = withBase('portada-computador.webp');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#acd2ed" />
    <meta name="description" content="Entrada al laboratorio de ciberseguridad de Walter." />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <title>Walter’s Digital Lab</title>
  </head>
  <body>
    <main class="cover" id="cover">
      <header class="masthead">
        <span class="monogram" aria-hidden="true">w<span>.</span></span>
        <h1>Walter’s Digital Lab</h1>
      </header>
      <a class="portal" href={withBase('inicio/')} aria-label="Entrar al laboratorio de ciberseguridad">
        <div class="camera">
          <div class="object">
            <img src={workstation} alt="Computador de escritorio con un escudo en la pantalla" fetchpriority="high" draggable="false" />
            <span class="glass" aria-hidden="true"></span>
          </div>
        </div>
        <span class="enter">Entrar al laboratorio <span class="arrow" aria-hidden="true">↗</span></span>
      </a>
    </main>
    <script>
      const cover = document.querySelector<HTMLElement>('#cover')!;
      const link = cover.querySelector<HTMLAnchorElement>('.portal')!;
      const camera = cover.querySelector<HTMLElement>('.camera')!;
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      let journey: Animation | undefined;

      link.addEventListener('pointermove', event => {
        if (event.pointerType !== 'mouse' || reduced.matches || journey) return;
        const box = camera.getBoundingClientRect();
        const x = Math.max(-1, Math.min(1, (event.clientX-box.left)/box.width*2-1));
        const y = Math.max(-1, Math.min(1, (event.clientY-box.top)/box.height*2-1));
        camera.style.setProperty('--yaw', x*3.6+'deg');
        camera.style.setProperty('--pitch', -y*2.4+'deg');
      });
      function center() {
        camera.style.removeProperty('--yaw');
        camera.style.removeProperty('--pitch');
      }
      link.addEventListener('pointerleave', center);
      link.addEventListener('click', event => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        if (reduced.matches || typeof camera.animate !== 'function') return;
        event.preventDefault();
        if (journey) return;
        center();
        const box = camera.getBoundingClientRect();
        const screenX = 0.45, screenY = 0.34;
        const dx = innerWidth/2 - (box.left + box.width*screenX);
        const dy = innerHeight/2 - (box.top + box.height*screenY);
        const zoom = Math.max(innerWidth/(box.width*0.28), innerHeight/(box.height*0.27));
        camera.style.transformOrigin = (100*screenX)+'% '+(100*screenY)+'%';
        cover.classList.add('entering');
        journey = camera.animate([
          { transform:'translate(0,0) scale(1)', offset:0 },
          { transform:'translate('+dx*.035+'px,'+dy*.035+'px) scale(1.075)', offset:.23 },
          { transform:'translate('+dx+'px,'+dy+'px) scale('+zoom+')' }
        ], { duration:1100, easing:'cubic-bezier(.42,0,.25,1)', fill:'forwards' });
        journey.onfinish = () => location.assign(link.href);
      });
      window.addEventListener('pageshow', () => {
        journey?.cancel(); journey = undefined;
        camera.style.removeProperty('transform-origin');
        cover.classList.remove('entering'); center();
      });
    </script>
  </body>
</html>
<style>
  :global(*){box-sizing:border-box}
  :global(html),:global(body){margin:0;min-height:100%;background:#acd2ed;color:#243943;font-family:'Segoe UI',system-ui,sans-serif}
  .cover{position:relative;min-height:100svh;overflow:clip;display:grid;grid-template-rows:auto 1fr;background:radial-gradient(ellipse at 50% 44%,#aed3ee 0%,#acd2ed 50%,#a6cbe5 100%)}
  .masthead{position:relative;z-index:2;display:flex;align-items:center;gap:.9rem;padding:clamp(1.4rem,3vw,3rem) clamp(1.4rem,4vw,4.5rem);pointer-events:none;transition:opacity .2s}
  .masthead h1{font-size:clamp(1rem,1.8vw,1.3rem);font-weight:600;letter-spacing:-.045em;margin:0}
  .monogram{background:#253b45;color:#f2f4ed;width:2.2rem;height:2.2rem;display:inline-flex;align-items:center;justify-content:center;border-radius:8px;font-size:1.6rem;font-weight:700;letter-spacing:-.13em;padding:0 .18em .08em 0}
  .monogram span{color:#f29b67}
  .portal{color:inherit;text-decoration:none;align-self:center;justify-self:center;display:flex;flex-direction:column;align-items:center;gap:clamp(.5rem,2vh,1.5rem);margin:0 0 clamp(1.8rem,6vh,5rem);outline-offset:6px;border-radius:1rem;-webkit-tap-highlight-color:transparent}
  .camera{width:min(92vw,110svh,1050px);aspect-ratio:3/2;perspective:1000px;position:relative;z-index:1;transform:translateZ(0)}
  .object{width:100%;height:100%;transform:rotateY(var(--yaw,0deg)) rotateX(var(--pitch,0deg));transition:transform .25s ease-out}
  .object img{display:block;width:100%;height:100%;object-fit:contain;user-select:none;mask-image:linear-gradient(90deg,transparent,#000 9%,#000 91%,transparent),linear-gradient(transparent,#000 3%,#000 97%,transparent);mask-composite:intersect}
  .enter{position:relative;z-index:2;display:inline-flex;align-items:center;gap:1rem;padding:.65rem .8rem .65rem 1.25rem;border:1px solid #6a808b;border-radius:3rem;font-weight:600;font-size:.98rem;background:#e6edefa6;transition:background .2s,opacity .2s}
  .arrow{display:grid;place-items:center;background:#293f49;color:white;border-radius:50%;width:1.6rem;height:1.6rem}
  .portal:focus-visible{outline:3px solid #224e63}
  .portal:hover .enter,.portal:focus-visible .enter{background:#f4f6f5}
  .entering .masthead,.entering .enter{opacity:0}
  .cover::after{content:'';position:absolute;inset:0;background:#141a1b;opacity:0;z-index:3;pointer-events:none}
  .cover.entering::after{opacity:1;transition:opacity .18s ease-in .92s}
  @media(max-width:600px){.camera{width:100vw}.portal{gap:1.5rem}.enter{font-size:.92rem}}
  .object{position:relative}
  .glass{position:absolute;left:26.2%;top:12.9%;width:36.1%;height:41.6%;overflow:hidden;pointer-events:none;border-radius:17% 15% 13% 13% / 12%;transform:rotate(.35deg)}
  @media(prefers-reduced-motion:no-preference){
    .camera{animation:approach 1.25s cubic-bezier(.18,.74,.24,1) backwards}
    .object{animation:drift 9s ease-in-out 1.25s infinite alternate}
    .glass{animation:power-on 1.2s ease-out backwards}
    .glass::after{content:'';position:absolute;inset:-70% -60%;background:linear-gradient(115deg,transparent 46%,rgb(190 243 255 / .16) 50%,transparent 54%);animation:reflection 7s ease-in-out 1s infinite}
    .portal:hover .arrow,.portal:focus-visible .arrow{transform:translate(2px,-2px)}
    .arrow{transition:transform .2s}
    .entering .object{animation-play-state:paused}
    .entering .glass{background:radial-gradient(ellipse at center,rgb(135 240 244 / .2),transparent 70%);transition:background .2s}
  }
  @keyframes approach{from{scale:.88;translate:0 2vh;opacity:0}to{scale:1;translate:0 0;opacity:1}}
  @keyframes drift{from{translate:-.55% .2%;scale:.995}to{translate:.55% -.2%;scale:1.013}}
  @keyframes power-on{0%,18%{background-color:rgb(11 29 36 / .94)}55%{background-color:rgb(11 29 36 / .52)}100%{background-color:transparent}}
  @keyframes reflection{0%,32%{transform:translateX(-52%);opacity:0}48%{opacity:.9}67%,100%{transform:translateX(52%);opacity:0}}
  @media(max-height:560px) and (orientation:landscape){.masthead{padding:.65rem 1.25rem}.camera{width:min(74vw,86svh)}.portal{gap:.25rem;margin:0 0 .75rem}}
  @media(prefers-reduced-motion:reduce){.object{transform:none;transition:none}.enter,.masthead{transition:none}}
</style>
