---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/content';
---
<Layout title="Buscar"><div class="page-heading"><div><p class="eyebrow">CONECTA TUS IDEAS</p><h1>Buscar en el laboratorio</h1><p>Busca por subtítulo, módulo o palabras de tus apuntes.</p></div></div><form id="search-form" class="search-form" role="search" data-index={withBase('search-index.json')}><div><label for="query">¿Qué quieres repasar?</label><input id="query" name="q" type="search" placeholder="Prueba con DNS, permisos o SHA-256…" autocomplete="off" /></div><div><label for="category">Tema</label><select id="category" name="categoria"><option value="">Todos los temas</option>{['Redes','Linux','Otros'].map(category => <option>{category}</option>)}</select></div><button class="button primary" type="submit">Buscar</button></form><p id="search-status" class="status-message" role="status" aria-live="polite">Cargando el índice…</p><div id="search-results" class="cards-grid"></div><noscript><div class="callout">Activa JavaScript para usar el buscador. Puedes leer todo el contenido desde el diario y los laboratorios.</div></noscript><script src="../scripts/search.ts"></script><style is:global>
  #search-results .entry-card{position:relative;cursor:pointer}
  #search-results .entry-card a::after{content:'';position:absolute;inset:0}
  #search-results .entry-card:focus-within,#search-results .entry-card:hover{border-color:var(--accent)}
</style></Layout>
